{
  "mcpServers": {
    "lsf": {
      "command": "/path/to/lsf-mcp-server/venv/bin/python",
      "args": ["-m", "lsf_mcp_server.server"],
      "env": {
        "LSF_SERVER_URL": "http://lsf-server.example.com:8088",
        "LSF_USERNAME": "YOUR_LSF_USERNAME_HERE",
        "LSF_PASSWORD": "YOUR_LSF_PASSWORD_HERE"
      }
    }
  }
}